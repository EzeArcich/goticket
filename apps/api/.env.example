# Copiar a .env local (ignorado). Nunca guardar credenciales reales en Git.
# La API, Prisma CLI y el seeder cargan .env desde apps/api.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://<usuario>:<password>@localhost:5432/goticket?schema=public
SHADOW_DATABASE_URL=postgresql://<usuario>:<password>@localhost:5432/goticket_shadow?schema=public

# Seeder opt-in: completar solo localmente; bcrypt admite máximo 72 bytes.
ALLOW_USER_SEED=false
SEED_USER_PASSWORD=

# Integración: configurar en .env.test, NO reutilizar DATABASE_URL.
# TEST_DATABASE_URL=postgresql://<usuario>:<password>@localhost:5432/goticket_test?schema=public
# Alternativa sin crear base en la instancia del sistema: pnpm test:integration:local
